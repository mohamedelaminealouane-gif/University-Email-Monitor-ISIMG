    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this email and determine:\n1. What type of event is it? (session_cancelled, exam_date, schedule_change, announcement, other)\n2. What is the importance level? (high, medium, low)\n3. Provide a brief summary\n\nEmail subject: {{ $json.subject }}\nEmail body: {{ $json.text }}",
