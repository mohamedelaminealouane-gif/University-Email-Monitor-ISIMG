    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this document text and determine:\n1. Is it a course document (lecture notes, slides, exercises)?\n2. If yes, identify the subject/course name\n3. If no, classify what type of document it is\n\nDocument text (first pages):\n{{ $json.data }}\n\nEmail subject: {{ $(\"New Email Received\").item.json.subject }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a document classifier for a university email system. Analyze documents and extract the subject/course name accurately. Return structured output with documentType (course_material, administrative, exam, other), subject (course name if applicable), and confidence (high, medium, low)."
        }
      },
      "id": "ce7a4877-c090-4d3f-8a18-993cb746ca82",
      "name": "Classify Document",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": {
          "documentType": "course_material",
          "subject": "Database Systems",
          "confidence": "high"
        }
      },
